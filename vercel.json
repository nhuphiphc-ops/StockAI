{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "data/**"
      }
    },
    {
      "src": "templates/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "templates/batdongsan_analysis.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/batdongsan-analysis",
      "dest": "/templates/batdongsan_analysis.html"
    },
    {
      "src": "/(.*)",
      "dest": "/templates/index.html"
    }
  ]
}