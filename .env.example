# Mau bien moi truong. Chep thanh .env roi dien gia tri that.
# .env da duoc .gitignore chan, KHONG BAO GIO commit file .env len GitHub.

# --- Lich su kien vi mo ---------------------------------------------------
# Key mien phi, lay tai: https://fredaccount.stlouisfed.org/apikey
# Dinh dang: 32 ky tu chu thuong + so.
# Dung de tu dong lay ngay cong bo CPI / PPI / PCE / Bao cao viec lam My.
# Thieu bien nay thi lich van chay va van hien dung thang hien tai,
# chi la khong co su kien tu dong - giao dien se hien canh bao mau vang.
# Tren Vercel: Settings -> Environment Variables -> them roi Redeploy.
FRED_API_KEY=

# --- Supabase (luu nhat ky tin hieu phai sinh M5) --------------------------
# Du an mien phi tai supabase.com. Truoc khi dung, chay trong SQL Editor:
#
#   create table if not exists derivatives_signals (
#       id bigint generated always as identity primary key,
#       trade_date date not null,
#       trade_time time not null,
#       trend text not null,
#       action text not null,
#       entry text not null,
#       sl text not null,
#       tp text not null,
#       created_at timestamptz not null default now()
#   );
#   create index if not exists idx_derivatives_signals_date on derivatives_signals(trade_date);
#
# SUPABASE_URL: Settings -> API -> Project URL.
# SUPABASE_KEY: Settings -> API -> service_role secret (KHONG PHAI anon/public key -
# service_role bo qua RLS vi moi luot ghi/doc deu di qua backend, khong bao gio lo ra
# trinh duyet). Thieu bien nay thi nhat ky M5 van hoat dong binh thuong (tinh tin hieu,
# hien ket qua) nhung khong luu duoc gi - giao dien se hien canh bao mau vang thay vi
# gia vo nhu khong co lenh nao.
# Tren Vercel: Settings -> Environment Variables -> them roi Redeploy.
SUPABASE_URL=
SUPABASE_KEY=
