# Mau bien moi truong. Chep thanh .env roi dien gia tri that.
# .env da duoc .gitignore chan, KHONG BAO GIO commit file .env len GitHub.

# --- Lich su kien vi mo ---------------------------------------------------
# Key mien phi, lay tai: https://fredaccount.stlouisfed.org/apikey
# Dinh dang: 32 ky tu chu thuong + so.
# Dung de tu dong lay ngay cong bo CPI / PPI / PCE / Bao cao viec lam My.
# Thieu bien nay thi lich van chay va van hien dung thang hien tai,
# chi la khong co su kien tu dong - giao dien se hien canh bao mau vang.
# Tren Vercel: Settings -> Environment Variables -> them roi Redeploy.
FRED_API_KEY=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
